<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="wallet" nsURI="http://example.org/wallet" nsPrefix="wallet">
  <eClassifiers xsi:type="ecore:EClass" name="Wallet">
    <eStructuralFeatures xsi:type="ecore:EReference" name="cash" eType="#//Money"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Money">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="amount" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EFloat"/>
  </eClassifiers>
</ecore:EPackage>
