<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>tools.vitruv</groupId>
    <artifactId>tools.vitruv.neojoin.frontend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>tools.vitruv.neojoin.frontend.cli</artifactId>
  <name>Command Line Interface</name>
  <description>Command line interface to validate queries, generate view types and transform models.</description>

  <properties>
    <!-- the CLI jar is distributed through the CI artifacts, not through Maven Central -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tools.vitruv.neojoin.transformation.emf</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tools.vitruv.neojoin.frontend.language</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tools.vitruv.neojoin.common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tools.vitruv.neojoin.model</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.emf</groupId>
      <artifactId>org.eclipse.emf.ecore.xmi</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.xtext</groupId>
      <artifactId>org.eclipse.xtext</artifactId>
    </dependency>

    <!-- The integration tests use the shared models of this module. Its files are copied by the execution
         copy-shared-test-models (see below); the dependency documents the relation and makes the reactor build this
         module first. -->
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>tools.vitruv.neojoin.test-resources</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-engine</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- The integration tests pass the directories models and instances as model paths, so they have to be real
      directories: all shared meta-models and instances are unpacked next to the CLI's own. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>unpack-third-party-licenses</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>unpack-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/third-party/licenses</outputDirectory>
              <useSubDirectoryPerArtifact>true</useSubDirectoryPerArtifact>
              <includeScope>runtime</includeScope>
              <!-- not bundled, see the shade configuration -->
              <excludeArtifactIds>org.eclipse.osgi</excludeArtifactIds>
              <includes>**/LICENSE*,**/NOTICE*,**/license*,**/notice*,**/COPYING*,about.html,about.ini,about.mappings,about.properties,about_files/**</includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <!-- The integration tests need the shared test models as files (the model path is a list of directories). They are
               copied from the test-resources module, not unpacked from its jar: the jar does not exist in a build that stops
               before the package phase (mvn test), and the dependency plugin cannot unpack the classes directory (MDEP-98). -->
          <execution>
            <id>copy-shared-test-models</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
              <resources>
                <resource>
                  <directory>${maven.multiModuleProjectDirectory}/test-resources/src/main/resources</directory>
                  <includes>
                    <include>models/**</include>
                    <include>instances/**</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>copy-third-party-licenses</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF/licenses</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.build.directory}/third-party/licenses</directory>
                </resource>
                <!-- license texts of dependencies that have none in their jars (see the files for the sources) -->
                <resource>
                  <directory>${maven.multiModuleProjectDirectory}/third-party-licenses</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- lists the licenses of all dependencies that the shade plugin bundles (META-INF/THIRD-PARTY.txt). The build fails
           for a dependency without a license; add it to third-party-licenses.properties then. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>third-party-licenses</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>add-third-party</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/license</outputDirectory>
              <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
              <excludedScopes>test,provided</excludedScopes>
              <!-- not bundled, see the shade configuration -->
              <excludedArtifacts>org\.eclipse\.osgi</excludedArtifacts>
              <licenseMerges>
                <licenseMerge>Apache License, Version 2.0|The Apache Software License, Version 2.0|The Apache Software License, version 2.0|The Apache License, Version 2.0|Apache 2.0|Apache-2.0</licenseMerge>
                <licenseMerge>Eclipse Public License - v 2.0|Eclipse Public License, Version 2.0|The Eclipse Public License Version 2.0|EPL-2.0</licenseMerge>
                <licenseMerge>BSD-3-Clause|BSD License|BSD licence</licenseMerge>
              </licenseMerges>
              <useMissingFile>true</useMissingFile>
              <missingFile>${maven.multiModuleProjectDirectory}/third-party-licenses.properties</missingFile>
              <failOnMissing>true</failOnMissing>
              <!-- do not attach and deploy the missing file as an extra artifact -->
              <deployMissingFile>false</deployMissingFile>
              <!-- the file is only added to the jar by the shade plugin as META-INF/THIRD-PARTY.txt, not also to its root -->
              <addOutputDirectoryAsResourceDir>false</addOutputDirectoryAsResourceDir>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <configuration>
          <transformers>
            <transformer
              implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
              <mainClass>tools.vitruv.neojoin.frontend.cli.Main</mainClass>
              <manifestEntries>
                <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
              </manifestEntries>
            </transformer>
            <transformer
              implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
              <resource>plugin.properties</resource>
            </transformer>
            <!-- merges the NOTICE files of all dependencies into META-INF/NOTICE -->
            <transformer
              implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
              <projectName>NeoJoin</projectName>
              <addHeader>false</addHeader>
              <!-- the default heading claims a copyright of the Apache Software Foundation for this project -->
              <copyright>Notices of the third-party components in this jar.</copyright>
            </transformer>
            <!-- the shade filters remove the license files of all jars, including the project's own: add it again -->
            <transformer
              implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
              <resource>META-INF/LICENSE</resource>
              <file>${maven.multiModuleProjectDirectory}/LICENSE</file>
            </transformer>
            <transformer
              implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
              <resource>META-INF/THIRD-PARTY.txt</resource>
              <file>${project.build.directory}/license/THIRD-PARTY.txt</file>
            </transformer>
          </transformers>
          <minimizeJar>false</minimizeJar>
          <shadedArtifactAttached>false</shadedArtifactAttached>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- the parent POM enables this; the shaded sources jar (all dependencies) is not wanted -->
              <createSourcesJar>false</createSourcesJar>
              <artifactSet>
                <excludes>
                  <!-- not needed at runtime: OSGi framework (pulled in by EMF Ecore) -->
                  <exclude>org.eclipse.platform:org.eclipse.osgi</exclude>
                </excludes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>**/*.java</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>META-INF/INDEX.LIST</exclude>
                    <!-- the manifest of the fat jar comes from the manifest transformer -->
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <!-- EMF icon, defined by three jars -->
                    <exclude>modeling32.png</exclude>
                    <!-- metadata of single dependencies: the jar would contain the license and module descriptor of
                         whichever dependency comes first, not those of this project. The license texts are in
                         META-INF/licenses, the NOTICE files are merged by the notice transformer. -->
                    <exclude>META-INF/LICENSE*</exclude>
                    <exclude>LICENSE-*.txt</exclude>
                    <exclude>META-INF/DEPENDENCIES</exclude>
                    <exclude>META-INF/p2.inf</exclude>
                    <exclude>META-INF/MANIFEST.MF_gen</exclude>
                    <exclude>META-INF/*.kotlin_module</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>.options</exclude>
                    <exclude>.api_description</exclude>
                    <exclude>*.profile</exclude>
                    <exclude>*.html</exclude>
                    <exclude>about.*</exclude>
                    <exclude>about_files/*</exclude>
                    <exclude>plugin.xml</exclude>
                    <exclude>systembundle.properties</exclude>
                    <exclude>profile.list</exclude>
                    <exclude>**/*._trace</exclude>
                    <exclude>**/*.g</exclude>
                    <exclude>**/*.mwe2</exclude>
                    <exclude>**/*.xtext</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>